# Copiar como .env.local solo en el servidor o equipo local.
# Nunca subir .env.local a GitHub.

# Webhook de n8n donde se registra cada envío del formulario de reserva.
#
# Son variables de SERVIDOR: sin el prefijo NEXT_PUBLIC_, para que el secreto
# no acabe dentro del bundle que descarga el navegador. Y son de EJECUCIÓN,
# no de build: por eso van en `environment:` del docker-compose y no en
# `args:`, justo al revés que las NEXT_PUBLIC_* (ver el Dockerfile).
#
# Si se dejan vacías, el formulario sigue funcionando exactamente como antes
# —abre WhatsApp con el mensaje prerrellenado— y /api/reservas responde 204
# sin hacer nada. Es decir: no configurarlas no rompe ningún entorno.
#
# El secreto lo inventas tú (una cadena larga y aleatoria) y el workflow de
# n8n debe validarlo contra la cabecera X-Vita-Secret.
N8N_RESERVAS_WEBHOOK_URL=
N8N_RESERVAS_WEBHOOK_SECRET=

# Ficha de cita (/cita/[token]) contra caja-vita-lima. Ver
# docs/encargo-web-ficha-cita.md para el contrato completo.
#
# CAJA_API_URL y CAJA_API_SECRET son obligatorias para usar la ficha real.
# Si falta cualquiera, la ruta muestra un error explícito de configuración.
# No existe fallback automático a datos de prueba.
#
# Son variables de SERVIDOR (sin NEXT_PUBLIC_): la ficha llama a caja desde
# el servidor, nunca desde el navegador, y el secreto no puede llegar al
# cliente. El header que lo lleva es X-Caja-Secret, y caja lo compara en
# minúsculas (x-caja-secret) — ya costó tiempo una vez con el webhook de n8n.
CAJA_API_URL=
CAJA_API_SECRET=

# Opcional y solo de servidor: permite que el fetch server-side atraviese
# Deployment Protection de un Preview de Caja. Nunca usar NEXT_PUBLIC_*.
CAJA_VERCEL_PROTECTION_BYPASS=

# Stub local opt-in para desarrollo o pruebas. Es ignorado en producción y staging,
# incluso si vale true. Incluye los casos recurrentes explícitos:
# stub-recurrente-salud, stub-recurrente-sin-condiciones,
# stub-recurrente-comprobante, stub-sin-historial,
# stub-identificar-invalido y stub-identificar-rate.
CAJA_API_STUB_ENABLED=false

# Opcional: solo si quieres apuntar a otra propiedad de Google Analytics.
# Si se deja vacío, se usa la propiedad real de vitalimaspa.com (G-L3PW7G43CY).
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Dominio público del sitio. Se usa en canonical, sitemap, robots y JSON-LD.
# OJO: tiene que ser el dominio real de producción. Este archivo llegó a
# tener aquí "nueva.vitalimaspa.com" (el subdominio de pruebas) y copiarlo
# tal cual al servidor publicaba canonicals apuntando al sitio equivocado.
NEXT_PUBLIC_SITE_URL=https://www.vitalimaspa.com

# "production" (o vacío) = el sitio es indexable, comportamiento por defecto.
# Cualquier otro valor (ej. "staging") bloquea el rastreo en robots.txt y
# añade la cabecera X-Robots-Tag: noindex, nofollow en todas las rutas.
# Úsalo en nueva.vitalimaspa.com mientras el Wix siga siendo el sitio real,
# para que los dos dominios no compitan entre sí en Google.
NEXT_PUBLIC_SITE_ENV=production
